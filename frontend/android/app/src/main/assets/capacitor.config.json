{
	"appId": "io.ldelg.smartofflinenotes",
	"appName": "SmartNotes",
	"webDir": "www",
	"android": {
		"adjustMarginsForEdgeToEdge": "auto"
	},
	"plugins": {
		"Keyboard": {
			"resize": "body",
			"style": "dark",
			"resizeOnFullScreen": true
		},
		"StatusBar": {
			"overlaysWebView": false,
			"style": "DARK",
			"backgroundColor": "#0d0d0d"
		},
		"App": {
			"disableBackButtonHandler": true
		}
	}
}
